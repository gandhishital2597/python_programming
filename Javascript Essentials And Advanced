Answer:
<!DOCTYPE html>
<html>
<head>
    <title>YouTube Notification Feed</title>

    <style>
        .notification {
            width: 350px;
            padding: 15px;
            margin: 10px;
            border: 1px solid black;
            transition: opacity 0.5s;
        }

        .fade-out {
            opacity: 0;
        }

        .dismissBtn {
            cursor: pointer;
            margin-top: 10px;
        }
    </style>

</head>
<body>

<h2>YouTube Notifications</h2>

<button id="addNotification">Load New Notification</button>


<div id="notificationFeed">

    <div class="notification">
        <p>New video uploaded by Code Academy</p>
        <button class="dismissBtn">Dismiss</button>
    </div>

    <div class="notification">
        <p>Your video reached 10K views</p>
        <button class="dismissBtn">Dismiss</button>
    </div>

</div>


<script>

    let notificationFeed = document.getElementById("notificationFeed");
    let addButton = document.getElementById("addNotification");


    // Add dynamic notification
    addButton.addEventListener("click", function() {

        let card = document.createElement("div");

        card.className = "notification";


        card.innerHTML = `
            <p>New subscriber notification received!</p>
            <button class="dismissBtn">Dismiss</button>
        `;


        notificationFeed.appendChild(card);

    });



    // Event delegation for all dismiss buttons
    notificationFeed.addEventListener("click", function(event) {


        if (event.target.classList.contains("dismissBtn")) {


            let notification = event.target.parentElement;


            // Add fade animation
            notification.classList.add("fade-out");


            // Remove after animation completes
            setTimeout(() => {

                notification.remove();

            }, 500);

        }

    });


</script>

