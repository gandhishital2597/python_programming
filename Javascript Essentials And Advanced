    <title>Product Search</title>
</head>
<body>

    <h2>Check Console for Search Results</h2>

    <script>

        let products = [
            { id: 1, name: "iPhone 15" },
            { id: 2, name: "Samsung Galaxy S24" },
            { id: 3, name: "Laptop HP" },
            { id: 4, name: "iPhone 14" },
            { id: 5, name: "OnePlus Mobile" }
        ];


        // 1. Callback Version
        function searchProductsCallback(products, searchTerm, callback) {

            setTimeout(() => {

                let result = products.filter(product =>
                    product.name.toLowerCase().includes(searchTerm.toLowerCase())
                );

                callback(result);

            }, 1000);

        }


        // Calling Callback Version
        searchProductsCallback(products, "iphone", (result) => {
            console.log("Callback Result:");
            console.log(result);
        });



        // 2. Promise Version
        function searchProductsPromise(products, searchTerm) {

            return new Promise((resolve) => {

                setTimeout(() => {

                    let result = products.filter(product =>
                        product.name.toLowerCase().includes(searchTerm.toLowerCase())
                    );

                    resolve(result);

                }, 1000);

            });

        }


        // Calling Promise Version
        searchProductsPromise(products, "mobile")
            .then((result) => {
                console.log("Promise Result:");
                console.log(result);
            });


    </script>

</body
</html>

