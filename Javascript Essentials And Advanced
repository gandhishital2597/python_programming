    <div class="card">
        <span>Perfect - Ed Sheeran</span>
        <span class="remove">X</span>
    </div>

    <div class="card">
        <span>Believer - Imagine Dragons</span>
        <span class="remove">X</span>
    </div>

    <div class="card">
        <span>Counting Stars - OneRepublic</span>
        <span class="remove">X</span>
    </div>

</div>


<script>

    let songContainer = document.getElementById("songContainer");


    // Event delegation
    songContainer.addEventListener("click", function(event) {

        // Check if clicked element is X button
        if (event.target.classList.contains("remove")) {

            // Remove only that song card
            event.target.parentElement.remove();

        }

    });

</script>

